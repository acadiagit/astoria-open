# --- Secrets & Environment (NEVER COMMIT) ---
.env
*.env.*
gcloud-service-key.json
*.pem
*.key

# --- System & IDE Files ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Python ---
venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Node.js / Frontend ---
node_modules/
console/node_modules/
npm-debug.log
.pnp
.pnp.js
coverage/

# --- Build Outputs ---
# We ignore these because we can always recreate them with "npm run build"
dist/
build/

# --- Large/Temporary Data ---
# We are keeping Documentation and Utils!
# Only ignoring the 'data' folder if it contains massive datasets
data/
